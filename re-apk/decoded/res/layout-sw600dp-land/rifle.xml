<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="fill" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TableLayout android:padding="@dimen/activity_vertical_margin" android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1,2,3">
            <TableRow>
                <LinearLayout android:focusable="true" android:focusableInTouchMode="true" android:layout_width="0.0px" android:layout_height="0.0px" />
            </TableRow>
            <TableRow>
                <Button android:textStyle="bold" android:id="@id/ButtonRiflesList" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/row_padding" android:layout_span="2" android:text="@string/change_rifle_label" android:singleLine="false" android:layout_weight="2.0" style="@style/regularTextStyle" />
                <EditText android:textStyle="bold" android:layout_gravity="center_vertical" android:id="@id/EditRifleName" android:layout_margin="@dimen/row_padding" android:layout_span="2" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:layout_weight="2.0" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingTop="@dimen/row_padding">
                <Button android:textStyle="bold" android:id="@id/ButtonRifleScope" android:layout_width="wrap_content" android:layout_height="fill_parent" android:layout_marginLeft="@dimen/row_padding" android:layout_marginRight="@dimen/row_padding" android:layout_span="2" android:text="@string/scope_label" android:singleLine="false" android:layout_weight="2.0" style="@style/regularTextStyle" />
                <Button android:textStyle="bold" android:id="@id/ButtonCartridge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/row_padding" android:layout_marginRight="@dimen/row_padding" android:layout_span="2" android:text="@string/cartridge_label" android:layout_weight="2.0" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingTop="@dimen/row_padding">
                <TextView android:textStyle="bold" android:gravity="right" android:layout_gravity="center_vertical" android:paddingRight="@dimen/right_padding" android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/row_padding" android:text="@string/twist_rate_label" android:singleLine="false" style="@style/regularTextStyle" />
                <EditText android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/EditTwistRate" android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_marginRight="@dimen/row_padding" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="numberDecimal" android:imeOptions="actionDone" style="@style/regularTextStyle" />
                <RadioGroup android:orientation="vertical" android:id="@id/radioTwist" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/row_padding" android:layout_marginRight="@dimen/row_padding" android:layout_span="2">
                    <RadioButton android:id="@id/radioRight" android:layout_width="fill_parent" android:layout_height="fill_parent" android:button="@drawable/radiobuttonstyle" android:text="@string/right_twist_label" android:onClick="onRadioButtonClicked" style="@style/regularTextStyle" />
                    <RadioButton android:id="@id/radioLeft" android:layout_width="fill_parent" android:layout_height="fill_parent" android:button="@drawable/radiobuttonstyle" android:text="@string/left_twist_label" android:onClick="onRadioButtonClicked" style="@style/regularTextStyle" />
                </RadioGroup>
            </TableRow>
            <TableRow>
                <TextView android:textStyle="bold" android:gravity="center" android:layout_span="2" android:text="@string/note" android:singleLine="false" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow>
                <EditText android:textStyle="bold" android:id="@id/EditRifleNote" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/row_padding" android:layout_marginRight="@dimen/row_padding" android:layout_span="2" android:text="@string/empty_text" android:lines="3" android:minLines="1" android:singleLine="true" android:selectAllOnFocus="true" android:layout_weight="2.0" android:inputType="textMultiLine" android:imeOptions="actionDone" style="@style/regularTextStyle" />
                <Button android:textStyle="bold" android:id="@id/ButtonSelectTargetType" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/row_padding" android:layout_marginRight="@dimen/row_padding" android:layout_span="2" android:text="@string/target_type_label" android:layout_weight="2.0" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow>
                <Button android:textStyle="bold" android:id="@id/ButtonTableSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/row_padding" android:layout_span="2" android:text="@string/table_settings_label" android:layout_weight="2.0" style="@style/regularTextStyle" />
                <Button android:textStyle="bold" android:id="@id/ButtonMRD" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/row_padding" android:layout_marginLeft="@dimen/row_padding" android:layout_marginRight="@dimen/row_padding" android:layout_span="2" android:text="@string/mrd_btn_label" android:layout_weight="2.0" style="@style/regularTextStyle" />
            </TableRow>
        </TableLayout>
        <LinearLayout android:orientation="horizontal" android:paddingLeft="@dimen/activity_vertical_margin" android:paddingRight="@dimen/activity_vertical_margin" android:paddingBottom="@dimen/activity_vertical_margin" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <Button android:textStyle="bold" android:id="@id/ButtonOK" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/row_padding" android:layout_marginRight="@dimen/row_padding" android:text="@string/close_label" style="@style/regularTextStyle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
