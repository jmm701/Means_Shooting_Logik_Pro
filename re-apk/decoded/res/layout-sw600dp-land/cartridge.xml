                <EditText android:layout_gravity="center_vertical" android:id="@id/EditCartridgeName" android:layout_span="2" android:text="@string/empty_text" android:singleLine="true" android:selectAllOnFocus="true" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="5.0dip">
                <TextView android:textStyle="bold" android:gravity="center|right" android:id="@id/LabelBulletSpeed" android:paddingRight="@dimen/right_padding" android:text="@string/BulletSpeed_label" style="@style/regularTextStyle" />
                <Button android:textStyle="bold" android:id="@id/ButtonBulletSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_text" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:layout_gravity="center|right" android:id="@id/LabelBulletLength" android:paddingRight="@dimen/right_padding" android:text="@string/bullet_length_label" android:singleLine="false" android:layout_weight="0.4" style="@style/regularTextStyle" />
                <EditText android:textStyle="bold" android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/EditBulletLength" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="5.0dip">
                <TextView android:textStyle="bold" android:gravity="right" android:id="@id/LabelBulletTemp" android:paddingRight="@dimen/right_padding" android:text="@string/BulletTemperature_label" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:textColor="#ff75b1fb" android:gravity="center_horizontal" android:id="@id/ValueBulletTemp" android:text="@string/zero_text" android:singleLine="true" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:layout_gravity="center|right" android:id="@id/LabelBulletDiameter" android:paddingRight="@dimen/right_padding" android:text="@string/bullet_diam_label" android:singleLine="false" android:layout_weight="0.4" style="@style/regularTextStyle" />
                <EditText android:textStyle="bold" android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/EditBulletDiameter" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="5.0dip">
                <TextView android:textStyle="bold" android:layout_gravity="center|right" android:id="@id/LabelBulletWeight" android:paddingRight="@dimen/right_padding" android:layout_span="3" android:text="@string/bullet_weight_label" android:singleLine="false" android:layout_weight="0.4" style="@style/regularTextStyle" />
                <EditText android:textStyle="bold" android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/EditBulletWeight" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding">
                <TextView android:textStyle="bold" android:gravity="center|right" android:paddingRight="@dimen/right_padding" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_span="2" android:text="@string/bc_label2" style="@style/regularTextStyle" />
                <Button android:textStyle="bold" android:id="@id/ButtonMultiBC" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/multi_bc" android:singleLine="false" style="@style/regularTextStyle" />
                <EditText android:textStyle="bold" android:gravity="center" android:id="@id/EditBulletBC" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding">
                <TextView android:textStyle="bold" android:gravity="center" android:paddingRight="@dimen/right_padding" android:text="@string/drag_function_label" style="@style/regularTextStyle" />
