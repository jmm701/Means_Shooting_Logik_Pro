            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding">
                <TextView android:textStyle="bold" android:gravity="right" android:id="@id/LabelVerticalOffset" android:paddingRight="@dimen/right_padding" android:text="@string/Vertical_offset_label" style="@style/regularTextStyle" />
                <EditText android:gravity="center" android:id="@id/EditVerticalOffset" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:gravity="right" android:id="@id/LabelHorizontalOffset" android:paddingRight="@dimen/right_padding" android:text="@string/Horizontal_offset_label" style="@style/regularTextStyle" />
