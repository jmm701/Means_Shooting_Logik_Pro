<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="fill" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TableLayout android:paddingLeft="@dimen/activity_vertical_margin" android:paddingRight="@dimen/activity_vertical_margin" android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1,2,3">
            <TableRow>
                <LinearLayout android:focusable="true" android:focusableInTouchMode="true" android:layout_width="0.0px" android:layout_height="0.0px" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding">
                <TextView android:textStyle="bold" android:gravity="center_horizontal" android:id="@id/LabelRifleName" android:layout_span="4" android:text="@string/rifle_label" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding">
