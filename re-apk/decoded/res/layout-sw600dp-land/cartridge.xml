        <TableLayout android:paddingLeft="15.0dip" android:paddingRight="15.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1,2,3">
            <TableRow android:paddingBottom="@dimen/table_padding" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ImageButton android:id="@id/ButtonDBCartridges" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@null" android:scaleType="centerInside" />
                <ImageButton android:id="@id/ButtonBulletsG1" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@null" android:scaleType="centerInside" />
                <ImageButton android:id="@id/ButtonBulletsG7" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@null" android:scaleType="centerInside" />
                <ImageButton android:id="@id/ButtonPellets" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@null" android:scaleType="centerInside" />
