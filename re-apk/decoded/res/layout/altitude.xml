<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true" android:backgroundTint="#ff9f9c9c"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="fill" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TableLayout android:padding="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1">
            <TableRow>
                <LinearLayout android:focusable="true" android:focusableInTouchMode="true" android:layout_width="0.0px" android:layout_height="0.0px" />
            </TableRow>
            <TableRow android:paddingBottom="25.0dip">
                <TextView android:textStyle="bold" android:textColor="#fffef502" android:gravity="center_horizontal" android:id="@id/LabelWeather" android:layout_span="2" android:text="@string/altitude_label" android:singleLine="true" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="5.0dip">
                <TextView android:textStyle="bold" android:gravity="center|right" android:id="@id/LabelAltitude" android:paddingRight="10.0dip" android:layout_height="fill_parent" android:text="@string/Altitude_label" android:singleLine="false" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditAltitude" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="5.0dip">
                <CheckBox android:id="@id/checkGPS" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/gps_label" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="15.0dip">
                <Button android:textStyle="bold" android:id="@id/ButtonCalculate" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/calc_label" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="5.0dip">
                <TextView android:textStyle="bold" android:gravity="center|right" android:id="@id/LabelPressure" android:paddingRight="5.0dip" android:layout_width="fill_parent" android:layout_height="fill_parent" android:text="@string/Pressure_label" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:textColor="#ffff0000" android:gravity="center_horizontal" android:id="@id/ValuePressure" android:text="@string/zero_text" android:singleLine="true" style="@style/hugeTextStyle" />
            </TableRow>
            <TableRow android:paddingTop="@dimen/row_padding_big" android:paddingBottom="@dimen/row_padding_big">
                <Button android:textStyle="bold" android:textColor="#fffe0202" android:id="@id/ButtonOK" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/use_this_pressure_label" style="@style/regularTextStyle" />
            </TableRow>
        </TableLayout>
        <LinearLayout android:orientation="horizontal" android:paddingLeft="@dimen/table_padding" android:paddingRight="@dimen/table_padding" android:paddingBottom="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <Button android:textStyle="bold" android:layout_gravity="bottom" android:id="@id/ButtonCancel" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/close_label" style="@style/regularTextStyle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
