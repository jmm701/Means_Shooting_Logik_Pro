<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:padding="20.0dip" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:textStyle="bold" android:textColor="#ffffff00" android:gravity="center_horizontal" android:id="@id/LabelLocations" android:paddingBottom="@dimen/row_padding_big" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/location_list" android:singleLine="true" style="@style/regularTextStyle" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:padding="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_weight="0.1">
        <ListView android:id="@id/listLocations" android:layout_width="fill_parent" android:layout_height="fill_parent" android:cacheColorHint="#00000000" android:dividerHeight="1.0dip" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TableLayout android:padding="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1">
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <Button android:textStyle="bold" android:id="@id/ButtonAddLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_word" style="@style/regularTextStyle" />
                <Button android:textStyle="bold" android:id="@id/ButtonLocationDelete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/Delete_str" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow>
                <Button android:textStyle="bold" android:id="@id/ButtonEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/View_str" style="@style/regularTextStyle" />
                <Button android:textStyle="bold" android:id="@id/ButtonOK" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/close_label" style="@style/regularTextStyle" />
            </TableRow>
        </TableLayout>
    </LinearLayout>
</LinearLayout>
