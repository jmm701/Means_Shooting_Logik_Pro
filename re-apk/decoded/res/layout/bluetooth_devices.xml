<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TableLayout android:padding="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1">
        <TableRow android:paddingBottom="@dimen/row_padding">
            <TextView android:textStyle="bold" android:textColor="#ff75b1fb" android:gravity="center_horizontal" android:paddingTop="@dimen/row_padding" android:paddingBottom="@dimen/row_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/Bluetooth4Devices_label" android:singleLine="true" style="@style/regularTextStyle" />
        </TableRow>
        <TableRow android:paddingTop="@dimen/table_padding" android:paddingBottom="@dimen/row_padding">
            <TextView android:textStyle="bold" android:textColor="#fffef502" android:gravity="center_horizontal" android:paddingTop="@dimen/row_padding" android:paddingBottom="@dimen/row_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/weather_stations_label" android:singleLine="false" style="@style/regularTextStyle" />
        </TableRow>
        <TableRow android:paddingBottom="@dimen/row_padding">
            <Spinner android:id="@id/spinnerWeatherStations" android:paddingTop="@dimen/row_padding" android:paddingBottom="@dimen/row_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:drawSelectorOnTop="true" android:layout_span="2" />
        </TableRow>
        <TableRow android:paddingBottom="@dimen/row_padding">
            <TextView android:textStyle="bold" android:gravity="center_horizontal" android:paddingTop="@dimen/row_padding" android:paddingBottom="@dimen/row_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/saved_weather_station_id_label" android:singleLine="false" style="@style/regularTextStyle" />
        </TableRow>
        <TableRow android:paddingBottom="@dimen/row_padding">
            <TextView android:textStyle="bold" android:layout_gravity="center|right" android:id="@id/LabelSavedWeatherStationID_value" android:paddingRight="@dimen/right_padding" android:text="---" android:singleLine="false" style="@style/regularTextStyle" />
            <Button android:textStyle="bold" android:id="@id/ButtonDelete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/Delete_str" style="@style/regularTextStyle" />
        </TableRow>
        <TableRow android:paddingBottom="@dimen/row_padding">
            <TextView android:textStyle="bold" android:textColor="#fffef502" android:gravity="center_horizontal" android:paddingTop="@dimen/row_padding" android:paddingBottom="@dimen/row_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/wind_stations_label" android:singleLine="false" style="@style/regularTextStyle" />
        </TableRow>
        <TableRow android:paddingBottom="@dimen/row_padding">
            <Spinner android:id="@id/spinnerWindStations" android:paddingTop="@dimen/row_padding" android:paddingBottom="@dimen/row_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:drawSelectorOnTop="true" android:layout_span="2" />
        </TableRow>
        <TableRow android:paddingBottom="@dimen/row_padding">
            <TextView android:textStyle="bold" android:gravity="center_horizontal" android:paddingTop="@dimen/row_padding" android:paddingBottom="@dimen/row_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/saved_wind_meter_id_label" android:singleLine="false" style="@style/regularTextStyle" />
        </TableRow>
        <TableRow android:paddingBottom="@dimen/row_padding">
            <TextView android:textStyle="bold" android:layout_gravity="center|right" android:id="@id/LabelSavedWindMeterID_value" android:paddingRight="@dimen/right_padding" android:text="---" android:singleLine="false" style="@style/regularTextStyle" />
            <Button android:textStyle="bold" android:id="@id/ButtonDelete2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/Delete_str" style="@style/regularTextStyle" />
        </TableRow>
    </TableLayout>
    <RelativeLayout android:gravity="bottom" android:paddingLeft="@dimen/table_padding" android:paddingRight="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <Button android:textStyle="bold" android:id="@id/ButtonClose" android:paddingLeft="@dimen/table_padding" android:paddingRight="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/close_label" style="@style/regularTextStyle" />
    </RelativeLayout>
</LinearLayout>
