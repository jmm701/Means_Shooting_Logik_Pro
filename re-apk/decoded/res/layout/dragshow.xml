<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="fill" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TableLayout android:padding="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1">
            <TableRow>
                <LinearLayout android:focusable="true" android:focusableInTouchMode="true" android:layout_width="0.0px" android:layout_height="0.0px" />
            </TableRow>
            <TableRow android:paddingTop="15.0dip" android:paddingBottom="15.0dip">
                <EditText android:textStyle="bold" android:id="@id/EditDragFunctionName" android:layout_span="3" android:text="@string/drag_function_label" android:selectAllOnFocus="true" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <EditText android:textStyle="bold" android:id="@id/EditDragFunctionDescription" android:layout_span="3" android:text="@string/drag_function_description" android:singleLine="false" android:selectAllOnFocus="true" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:paddingRight="10.0dip" android:layout_span="2" android:text="@string/drag_sd_label" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditDragSD" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:numeric="decimal" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:paddingRight="10.0dip" android:layout_span="2" android:text="@string/bullet_length_label" android:singleLine="false" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditBulletLength" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:numeric="decimal" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:paddingRight="10.0dip" android:layout_span="2" android:text="@string/bullet_diam_label" android:singleLine="false" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditBulletDiameter" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:numeric="decimal" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:paddingRight="10.0dip" android:layout_span="2" android:text="@string/bullet_weight_label" android:singleLine="false" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditBulletWeight" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:numeric="decimal" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
        </TableLayout>
        <TableLayout android:id="@id/listDragElements" android:paddingLeft="@dimen/table_padding" android:paddingRight="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1">
            <TableRow>
                <TextView android:textStyle="bold" android:gravity="center_horizontal" android:text="@string/mach_label" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:gravity="center_horizontal" android:text="@string/cd_label" style="@style/regularTextStyle" />
            </TableRow>
        </TableLayout>
        <LinearLayout android:orientation="horizontal" android:paddingLeft="@dimen/table_padding" android:paddingTop="@dimen/table_padding" android:paddingRight="@dimen/table_padding" android:paddingBottom="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <Button android:textStyle="bold" android:layout_gravity="bottom" android:id="@id/ButtonOK" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ok_label" android:layout_weight="2.0" style="@style/regularTextStyle" />
            <Button android:textStyle="bold" android:layout_gravity="bottom" android:id="@id/ButtonCancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel_label" android:layout_weight="2.0" style="@style/regularTextStyle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
