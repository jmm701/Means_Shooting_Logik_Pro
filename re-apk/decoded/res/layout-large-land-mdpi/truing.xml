<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="fill" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TableLayout android:padding="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1,2,3">
            <TableRow>
                <LinearLayout android:focusable="true" android:focusableInTouchMode="true" android:layout_width="0.0px" android:layout_height="0.0px" />
            </TableRow>
            <TableRow android:paddingBottom="5.0dip">
                <TextView android:textStyle="bold" android:textColor="#ff75b1fb" android:gravity="center_horizontal" android:id="@id/LabelDopInfo" android:layout_span="4" android:text="@string/Trajectory_validation_label" android:singleLine="false" style="@style/bigTextStyle" />
            </TableRow>
            <TableRow>
                <TextView android:textColor="#ffb2ab92" android:gravity="center_horizontal" android:id="@id/LabelComment" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="4" android:text="@string/validation_comment_label" android:singleLine="false" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textColor="#ffb2ab92" android:gravity="center_horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/empty_text" android:singleLine="false" style="@style/regularTextStyle" />
                <RadioButton android:id="@id/radioButton_Speed" android:layout_width="fill_parent" android:layout_height="wrap_content" android:button="@drawable/radiobuttonstyle" android:layout_span="2" android:text="@string/truing_speed_label" android:singleLine="false" style="@style/regularTextStyle" />
                <RadioButton android:id="@id/radioButton_BC" android:layout_width="fill_parent" android:layout_height="wrap_content" android:button="@drawable/radiobuttonstyle" android:layout_span="1" android:text="@string/truing_bc_label" android:singleLine="false" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow>
                <TextView android:textColor="#ffb2ab92" android:gravity="center_horizontal" android:id="@id/LabelCurrentCartridge" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="4" android:text="@string/cartridge_label" android:singleLine="false" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textColor="#ffb2ab92" android:gravity="center" android:layout_gravity="center_vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="2" android:text="@string/distance_comment_label" android:lines="5" android:singleLine="false" />
                <TextView android:textStyle="bold" android:gravity="center|right" android:layout_gravity="center_vertical" android:id="@id/LabelDistance" android:paddingRight="@dimen/right_padding" android:layout_width="fill_parent" android:layout_height="fill_parent" android:text="@string/distance_label" style="@style/regularTextStyle" />
                <EditText android:textStyle="bold" android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/EditDistance" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:layout_gravity="center_vertical" android:id="@id/LabelCurrentVelocity" android:paddingRight="@dimen/right_padding" android:layout_span="3" android:text="@string/BulletSpeed_label" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:textColor="#ff75b1fb" android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/CurrentVelocity" android:text="@string/zero_text" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:layout_gravity="center_vertical" android:id="@id/ActualDropLabel" android:paddingRight="@dimen/right_padding" android:layout_span="2" android:text="@string/actual_drop_label" android:singleLine="false" style="@style/regularTextStyle" />
                <EditText android:textStyle="bold" android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/ActualDrop" android:layout_width="wrap_content" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
                <Spinner android:layout_gravity="center_vertical" android:id="@id/spinnerUnitsActualDrop" android:layout_width="fill_parent" android:layout_height="wrap_content" android:drawSelectorOnTop="true" android:layout_span="1" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <Button android:textStyle="bold" android:id="@id/ButtonCalculate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_span="4" android:text="@string/calc_label" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:layout_gravity="center_vertical" android:id="@id/LabelCalculatedVelocity" android:paddingRight="@dimen/right_padding" android:layout_span="3" android:text="@string/calculated_velocity_label" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:textColor="#ffff0000" android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/CalculatedVelocity" android:text="@string/zero_text" style="@style/bigTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <Button android:textStyle="bold" android:textColor="#ffff0000" android:id="@id/ButtonUseThisSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_span="4" android:text="@string/use_this_speed_label" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow>
                <Button android:textStyle="bold" android:id="@id/ButtonOK" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="4" android:text="@string/close_label" style="@style/regularTextStyle" />
            </TableRow>
        </TableLayout>
    </LinearLayout>
</ScrollView>
