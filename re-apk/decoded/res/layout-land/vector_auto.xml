                    <TableRow android:paddingBottom="@dimen/row_padding_big">
                        <TextView android:textStyle="bold" android:gravity="center" android:id="@id/vert_text_label" android:text="@string/Vert_label" />
                        <TextView android:textSize="22.0sp" android:textStyle="bold" android:textColor="#fffef502" android:gravity="center" android:id="@id/VertDropMOA" android:text="@string/zero_text" />
                        <TextView android:textSize="22.0sp" android:textStyle="bold" android:textColor="#ff00ff00" android:gravity="center" android:id="@id/VertDropMIL" android:text="@string/zero_text" />
                        <TextView android:textSize="22.0sp" android:textStyle="bold" android:textColor="#ffff00ff" android:gravity="center" android:id="@id/VertDropCM" android:text="@string/zero_text" />
                        <TextView android:textSize="22.0sp" android:textStyle="bold" android:textColor="#ff75b1fb" android:gravity="center" android:id="@id/VertDropClicks" android:text="@string/zero_text" />
                    </TableRow>
                    <TableRow android:paddingBottom="@dimen/row_padding_big">
                        <TextView android:textStyle="bold" android:gravity="center" android:id="@id/gor_text_label" android:text="@string/Hor_label" />
                        <TextView android:textSize="22.0sp" android:textStyle="bold" android:textColor="#fffef502" android:gravity="center" android:id="@id/GorWindMOA" android:text="@string/zero_text" />
                        <TextView android:textSize="22.0sp" android:textStyle="bold" android:textColor="#ff00ff00" android:gravity="center" android:id="@id/GorWindMIL" android:text="@string/zero_text" />
                        <TextView android:textSize="22.0sp" android:textStyle="bold" android:textColor="#ffff00ff" android:gravity="center" android:id="@id/GorWindCM" android:text="@string/zero_text" />
