                    </TableRow>
                    <TableRow android:paddingBottom="@dimen/row_padding_big">
                        <Button android:textStyle="bold" android:id="@id/ButtonSelectKestrel" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="5" android:text="@string/select_kestrel_label" style="@style/regularTextStyle" />
                    </TableRow>
                </TableLayout>
            </TableRow>
        </TableLayout>
        <RelativeLayout android:gravity="bottom" android:paddingLeft="@dimen/table_padding" android:paddingRight="@dimen/table_padding" android:paddingBottom="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="fill_parent">
