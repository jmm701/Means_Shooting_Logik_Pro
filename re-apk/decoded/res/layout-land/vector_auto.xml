                        <TextView android:textStyle="bold" android:textColor="#ffff00ff" android:gravity="center" android:id="@id/cm_text_label" android:text="@string/cm_text" />
                        <TextView android:textStyle="bold" android:textColor="#ff75b1fb" android:gravity="center" android:text="@string/clicks_text" />
