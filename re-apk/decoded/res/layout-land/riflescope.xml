<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="fill" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TableLayout android:padding="@dimen/table_padding" android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:stretchColumns="0,1,2,3">
            <TableRow>
                <LinearLayout android:focusable="true" android:focusableInTouchMode="true" android:layout_width="0.0px" android:layout_height="0.0px" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="center_horizontal" android:id="@id/LabelRifleName" android:layout_span="4" android:text="@string/rifle_label" android:singleLine="true" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="center|right" android:id="@id/LabelZeroDistance" android:paddingRight="@dimen/right_padding" android:layout_width="fill_parent" android:layout_height="fill_parent" android:text="@string/ZeroDistance_label" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditZeroDistance" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:gravity="center|right" android:id="@id/ScopeClickVertlabel" android:paddingRight="@dimen/right_padding" android:layout_width="fill_parent" android:layout_height="fill_parent" android:text="@string/ScopeClickVert_label" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditScopeClickVert" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="center|right" android:id="@id/LabelScopeHeight" android:paddingRight="@dimen/right_padding" android:text="@string/ScopeHeight_label" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditScopeHeight" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
                <TextView android:textStyle="bold" android:gravity="center|right" android:id="@id/ScopeClickGorlabel" android:paddingRight="@dimen/right_padding" android:layout_width="fill_parent" android:layout_height="fill_parent" android:text="@string/ScopeClickGor_label" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditScopeClickGor" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="center|right" android:layout_gravity="center_vertical" android:paddingRight="@dimen/right_padding" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_span="3" android:text="@string/click_units_label" style="@style/regularTextStyle" />
                <Spinner android:gravity="center_vertical" android:layout_gravity="center_vertical" android:id="@id/spinnerScopeUnits" android:layout_width="fill_parent" android:layout_height="wrap_content" android:drawSelectorOnTop="true" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="center|right" android:paddingRight="@dimen/right_padding" android:layout_width="fill_parent" android:layout_height="fill_parent" android:text="@string/ScopeReticle_label" style="@style/regularTextStyle" />
                <Spinner android:gravity="center_vertical" android:layout_gravity="center_vertical" android:id="@id/spinnerReticle" android:layout_width="fill_parent" android:layout_height="wrap_content" android:drawSelectorOnTop="true" android:layout_span="2" style="@style/regularTextStyle" />
                <Button android:textStyle="bold" android:id="@id/ButtonSearch" android:layout_width="fill_parent" android:layout_height="fill_parent" android:text="@string/Search_label" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <CheckBox android:id="@id/m_ffp_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:button="@drawable/checkbox_custom_01" android:layout_span="4" android:text="@string/FFP_label" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:id="@id/LabelMinMag" android:paddingRight="10.0dip" android:layout_span="3" android:text="@string/MinMag_label" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditMinMag" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:layout_gravity="center_vertical" android:id="@id/LabelTrueMag" android:paddingRight="10.0dip" android:layout_span="3" android:text="@string/TrueMag_label" android:singleLine="false" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditTrueMag" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:gravity="right" android:id="@id/LabelMaxMag" android:paddingRight="10.0dip" android:layout_span="3" android:text="@string/MaxMag_label" style="@style/regularTextStyle" />
                <EditText android:id="@id/EditMaxMag" android:text="@string/zero_text" android:singleLine="true" android:selectAllOnFocus="true" android:inputType="phone" android:imeOptions="actionDone" style="@style/regularTextStyle" />
            </TableRow>
            <TableRow android:paddingBottom="@dimen/row_padding_big">
                <TextView android:textStyle="bold" android:textColor="#ffff0000" android:gravity="center_horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_span="4" android:text="@string/scopecomment_label" android:singleLine="false" />
            </TableRow>
        </TableLayout>
        <LinearLayout android:orientation="horizontal" android:paddingLeft="@dimen/table_padding" android:paddingRight="@dimen/table_padding" android:paddingBottom="@dimen/table_padding" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <Button android:textStyle="bold" android:layout_gravity="bottom" android:id="@id/ButtonOK" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ok_label" android:layout_weight="2.0" style="@style/regularTextStyle" />
            <Button android:textStyle="bold" android:layout_gravity="bottom" android:id="@id/ButtonCancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel_label" android:layout_weight="2.0" style="@style/regularTextStyle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
